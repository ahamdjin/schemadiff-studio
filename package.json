{
  "name": "schemadiff-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Release-review workbench for OpenAPI contract changes",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build": "npm test && node --check public/app.js && node --check server.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@oasdiff-js/oasdiff-js": "1.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
